# Production environment template — real values live only in the deployment
# secret manager (Hostinger environment variables). NEVER commit real values.
# The app connects to MySQL on the same host: 127.0.0.1:3306 (never the
# public srvNNNN hostname, and never from client-side code).
NODE_ENV=production
APP_NAME=
APP_URL=
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
AUTH_SESSION_SECRET=
SESSION_TTL_SECONDS=3600
AUTH_MFA_REQUIRED_FOR_PRIVILEGED=true
TRUSTED_ORIGINS=
STORAGE_BUCKET=
# Optional: separate signing secret if JWT-based sessions are enabled
JWT_SECRET=
